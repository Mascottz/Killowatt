# killowatt environment; copy to .env (which is git-ignored), fill in what
# you have, and source it. everything works without any of this; each
# variable only wakes up one more piece.

# --- cloudflare: live metering + the suspend adapter ---
# token with account-scoped Workers Scripts: Edit and Analytics: Read
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# the graphql metering api wants the account tag; usually the same value.
# scripts/check-cloudflare.sh tells you if the two differ.
# CLOUDFLARE_ACCOUNT_TAG=
# which account the live poller meters; defaults to the first policy account
# KILOWATT_METER_ACCOUNT=acme-prod
# tripped service → worker script to suspend; without it, service name is used
# KILOWATT_WORKER_MAP=api=my-api-worker,edge=my-edge-worker

# --- aws: the scale-to-zero adapter ---
# least privilege is autoscaling:UpdateAutoScalingGroup on your group arns
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# tripped service → auto scaling group; without it, service name is used
# KILOWATT_ASG_MAP=api=prod-api-asg,workers=prod-workers-asg

# --- alert sinks: either, both, or neither; the log is the fallback ---
# KILOWATT_SLACK_WEBHOOK=
# KILOWATT_DISCORD_WEBHOOK=

# --- enforcement mode for scripts/watch-live.exs ---
# dry_run (the default) | cloudflare | aws
# KILOWATT_ENFORCE_MODE=dry_run
